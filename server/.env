DATABASE_URL="postgresql://postgres:postgres@localhost:5432/healthcare?schema=public"
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="1d"
PORT=5000
CLIENT_URL="http://localhost:5173"
NODE_ENV="development"

# For closing a unnessary server that is running on unused port.

# copy this : Get-NetTCPConnection -LocalPort 5000 | Select-Object -ExpandProperty OwningProcess | ForEach-Object { Stop-Process -Id $_ -Force }


Start PostgreSQL
From PowerShell: & 'C:\Program Files\PostgreSQL\18\bin\pg_ctl.exe' -D "C:\Program Files\PostgreSQL\18\data" start


Stop PostgreSQL : & 'C:\Program Files\PostgreSQL\18\bin\pg_ctl.exe' -D "C:\Program Files\PostgreSQL\18\data" stop


If you want to check if it is running:

Test-NetConnection -ComputerName localhost -Port 5432


